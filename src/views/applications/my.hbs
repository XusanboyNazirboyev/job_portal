<div class="flex items-end justify-between mb-5">
  <div>
    <h1 class="text-2xl font-bold text-ink-900">My applications</h1>
    <p class="text-sm text-ink-500">Track every role you've applied for.</p>
  </div>
  <a href="/vacancies" class="px-4 py-2 rounded-full bg-brand-500 text-white text-sm font-semibold hover:bg-brand-600">Find more jobs</a>
</div>

<div class="grid md:grid-cols-2 gap-4">
  {{#each applications}}
  <article class="bg-white rounded-2xl shadow-card p-5 flex gap-4">
    <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 text-white grid place-items-center font-bold">
      {{#if vacancy.title}}{{vacancy.title.[0]}}{{else}}J{{/if}}
    </div>
    <div class="flex-1 min-w-0">
      <h2 class="font-semibold text-ink-900">{{vacancy.title}}</h2>
      <p class="text-sm text-ink-500">📍 {{vacancy.location}}</p>
      <div class="mt-3">
        {{#if (eq status 'accepted')}}
          <span class="chip bg-emerald-50 text-emerald-700">✓ Accepted</span>
        {{else if (eq status 'rejected')}}
          <span class="chip bg-rose-50 text-rose-700">✕ Not selected</span>
        {{else}}
          <span class="chip bg-amber-50 text-amber-700">● Pending review</span>
        {{/if}}
      </div>
    </div>
  </article>
  {{else}}
  <div class="md:col-span-2 bg-white rounded-2xl shadow-card p-10 text-center">
    <div class="text-4xl mb-2">🗂️</div>
    <h2 class="font-semibold text-ink-900">No applications yet</h2>
    <p class="text-sm text-ink-500 mt-1 mb-4">Start exploring open roles tailored to you.</p>
    <a href="/vacancies" class="px-4 py-2 rounded-full bg-brand-500 text-white text-sm font-semibold">Browse jobs</a>
  </div>
  {{/each}}
</div>
