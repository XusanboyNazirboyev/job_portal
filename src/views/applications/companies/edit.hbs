<div class="max-w-2xl mx-auto bg-white rounded-2xl shadow-card p-8">
  <h1 class="text-2xl font-bold text-ink-900">Edit vacancy</h1>
  <p class="text-sm text-ink-500 mt-1">Update the role details and keep your listing fresh.</p>

  {{#if error}}<div class="mt-5 px-4 py-2 rounded-lg bg-rose-50 text-rose-700 text-sm">{{error}}</div>{{/if}}

  <form action="/companies/{{vacancy.id}}?_method=PUT" method="POST" class="mt-6 space-y-4">
    <label class="block">
      <span class="text-sm font-medium text-ink-700">Title</span>
      <input type="text" name="title" required value="{{vacancy.title}}"
        class="mt-1 w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none"/>
    </label>
    <label class="block">
      <span class="text-sm font-medium text-ink-700">Description</span>
      <textarea name="description" rows="6"
        class="mt-1 w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none">{{vacancy.description}}</textarea>
    </label>
    <div class="grid md:grid-cols-2 gap-4">
      <label class="block">
        <span class="text-sm font-medium text-ink-700">Salary</span>
        <input type="number" name="salary" value="{{vacancy.salary}}"
          class="mt-1 w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none"/>
      </label>
      <label class="block">
        <span class="text-sm font-medium text-ink-700">Location</span>
        <input type="text" name="location" value="{{vacancy.location}}"
          class="mt-1 w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none"/>
      </label>
    </div>
    <label class="block">
      <span class="text-sm font-medium text-ink-700">Category ID</span>
      <input type="number" name="category_id" required value="{{vacancy.category_id}}"
        class="mt-1 w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none"/>
    </label>
    <div class="flex gap-2 pt-2">
      <button type="submit" class="px-6 py-2.5 rounded-full bg-brand-500 hover:bg-brand-600 text-white font-semibold">Save changes</button>
      <a href="/companies/panel" class="px-6 py-2.5 rounded-full border border-slate-300 text-ink-700 font-semibold hover:bg-slate-50">Cancel</a>
    </div>
  </form>
</div>
