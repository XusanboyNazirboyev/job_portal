<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{vacancy.title}}</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
  <nav class="navbar navbar-dark bg-dark px-4">
    <a class="navbar-brand" href="/">Job Portal</a>
    <div>
      <a href="/vacancies" class="text-white me-3">Vacancies</a>
      <a href="/auth/login" class="btn btn-outline-light btn-sm">Logout</a>
    </div>
  </nav>

  <div class="container mt-4">
    <div class="card shadow">
      <div class="card-body p-4">
        <h3>{{vacancy.title}}</h3>
        <p class="text-muted">{{vacancy.location}}</p>
        <p class="fw-bold text-success">${{vacancy.salary}}</p>
        <hr>
        <p>{{vacancy.description}}</p>
        <hr>
        <p><strong>Company:</strong> {{vacancy.company.name}}</p>
        <p><strong>Category:</strong> {{vacancy.category.name}}</p>
        <hr>

        {{#if error}}
          <div class="alert alert-danger">{{error}}</div>
        {{/if}}

        {{#if success}}
          <div class="alert alert-success">{{success}}</div>
        {{/if}}

        <form action="/applications" method="POST" enctype="multipart/form-data">
          <input type="hidden" name="vacancy_id" value="{{vacancy.id}}">
          <div class="mb-3">
            <label class="form-label">Resume (PDF/DOC)</label>
            <input type="file" name="resume" class="form-control" accept=".pdf,.doc,.docx" required>
          </div>
          <button type="submit" class="btn btn-primary">Apply Now</button>
          <a href="/vacancies" class="btn btn-outline-secondary ms-2">Back</a>
        </form>

      </div>
    </div>
  </div>
</body>
</html>