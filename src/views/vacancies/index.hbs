<form id="filterForm" action="/vacancies" method="GET" class="grid md:grid-cols-[260px_1fr_320px] gap-6">

  <aside class="hidden md:block space-y-4">
    <div class="bg-white rounded-2xl shadow-card p-5">
      <h3 class="font-semibold text-ink-900 mb-3">Filters</h3>
      
      <label class="block text-xs text-ink-500 mb-1">Location</label>
      <input 
        type="text"
        name="location" 
        value="{{filters.location}}"
        class="w-full px-3 py-2 mb-3 text-sm rounded-lg bg-surface-100 outline-none focus:ring-2 focus:ring-brand-500" 
        placeholder="Anywhere" 
        onkeypress="if(event.key === 'Enter') { event.preventDefault(); this.form.submit(); }"
      />
      
      <label class="block text-xs text-ink-500 mb-1">Job type</label>
      <div class="space-y-2 text-sm">
        <label class="flex items-center gap-2">
          <input type="radio" name="type" value="Full-time" class="accent-brand-500" onchange="this.form.submit()" {{#if (eq filters.type 'Full-time')}}checked{{/if}}/> 
          Full-time
        </label>
        <label class="flex items-center gap-2">
          <input type="radio" name="type" value="Part-time" class="accent-brand-500" onchange="this.form.submit()" {{#if (eq filters.type 'Part-time')}}checked{{/if}}/> 
          Part-time
        </label>
        <label class="flex items-center gap-2">
          <input type="radio" name="type" value="Contract" class="accent-brand-500" onchange="this.form.submit()" {{#if (eq filters.type 'Contract')}}checked{{/if}}/> 
          Contract
        </label>
        <label class="flex items-center gap-2">
          <input type="radio" name="type" value="Remote" class="accent-brand-500" onchange="this.form.submit()" {{#if (eq filters.type 'Remote')}}checked{{/if}}/> 
          Remote
        </label>
      </div>

      {{#if (or filters.location filters.type filters.sort)}}
        <hr class="my-4 border-slate-200"/>
        <a href="/vacancies" class="block text-center text-xs text-rose-600 hover:underline font-medium">Clear all filters</a>
      {{/if}}
    </div>
  </aside>

  <section>
    <div class="flex items-end justify-between mb-4">
      <div>
        <h1 class="text-2xl font-bold text-ink-900">Recommended for you</h1>
        <p class="text-sm text-ink-500">Based on your profile and search history</p>
      </div>
      
      <select name="sort" onchange="this.form.submit()" class="text-sm bg-white border border-slate-200 rounded-lg px-3 py-2 cursor-pointer outline-none">
        <option value="recent" {{#if (eq filters.sort 'recent')}}selected{{/if}}>Most recent</option>
        <option value="salary" {{#if (eq filters.sort 'salary')}}selected{{/if}}>Salary high–low</option>
      </select>
    </div>

    <div class="space-y-3">
      {{#each vacancies}}
      <article class="group bg-white rounded-2xl shadow-card p-5 hover:border-brand-500 border border-transparent transition flex gap-4">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 text-white grid place-items-center font-bold text-lg shrink-0">
          {{#if company.name}}{{company.name.[0]}}{{else}}J{{/if}}
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h2 class="font-semibold text-ink-900 group-hover:text-brand-600">
                <a href="/vacancies/{{id}}">{{title}}</a>
              </h2>
              <p class="text-sm text-ink-700">{{company.name}}</p>
              <p class="text-xs text-ink-500 mt-0.5 flex items-center gap-3">
                <span class="flex items-center gap-1">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s7-7 7-12a7 7 0 1 0-14 0c0 5 7 12 7 12Z"/><circle cx="12" cy="10" r="2.5"/></svg>
                  {{location}}
                </span>
                <span>·</span>
                <span>Posted recently</span>
              </p>
            </div>
            <button type="button" class="text-ink-500 hover:text-brand-600" aria-label="Save">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
            </button>
          </div>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <span class="chip bg-emerald-50 text-emerald-700">${{salary}}</span>
            <span class="chip bg-brand-50 text-brand-600">{{type}}</span>
            <span class="chip bg-slate-100 text-ink-700">On-site</span>
          </div>
          <div class="mt-4 flex items-center gap-2">
            <a href="/vacancies/{{id}}" class="px-4 py-1.5 rounded-full bg-brand-500 text-white text-sm font-semibold hover:bg-brand-600">View details</a>
            <a href="/vacancies/{{id}}" class="px-4 py-1.5 rounded-full border border-slate-300 text-ink-700 text-sm font-semibold hover:bg-slate-50">Easy Apply</a>
          </div>
        </div>
      </article>
      {{else}}
      <div class="bg-white rounded-2xl shadow-card p-10 text-center text-ink-500">No vacancies yet — check back soon.</div>
      {{/each}}
    </div>
  </section>

  <aside class="hidden lg:block space-y-4">
    <div class="bg-white rounded-2xl shadow-card p-5">
      <h3 class="font-semibold text-ink-900 mb-2">Job search tips</h3>
      <ul class="text-sm text-ink-700 space-y-2 list-disc pl-4">
        <li>Tailor your resume to each role.</li>
        <li>Apply within 24 hours of posting.</li>
        <li>Connect with the hiring manager.</li>
      </ul>
    </div>
    <div class="bg-gradient-to-br from-brand-500 to-brand-700 text-white rounded-2xl p-5">
      <h3 class="font-semibold mb-1">Upgrade your profile</h3>
      <p class="text-sm text-white/80 mb-3">Stand out with a verified resume and skills badges.</p>
      <a href="/users/me" class="inline-block px-4 py-1.5 rounded-full bg-white text-brand-600 text-sm font-semibold">Edit profile</a>
    </div>
  </aside>

</form>