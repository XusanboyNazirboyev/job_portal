<div class="flex items-center justify-between mb-5">
  <div>
    <h1 class="text-2xl font-bold text-ink-900">All companies</h1>
    <p class="text-sm text-ink-500">Registered employers on the platform.</p>
  </div>
  <a href="/admin/panel" class="px-4 py-2 rounded-full border border-slate-300 text-ink-700 text-sm font-semibold hover:bg-slate-50">← Back</a>
</div>

<div class="bg-white rounded-2xl shadow-card overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-slate-50 text-left text-xs uppercase tracking-wider text-ink-500">
      <tr>
        <th class="px-5 py-3">ID</th>
        <th class="px-5 py-3">Company</th>
        <th class="px-5 py-3">Website</th>
        <th class="px-5 py-3">Owner</th>
        <th class="px-5 py-3 text-right">Action</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      {{#each companies}}
      <tr class="hover:bg-slate-50">
        <td class="px-5 py-3 text-ink-500">{{id}}</td>
        <td class="px-5 py-3">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-emerald-500 to-emerald-700 text-white grid place-items-center font-bold">{{#if name}}{{name.[0]}}{{else}}C{{/if}}</div>
            <span class="font-medium text-ink-900">{{name}}</span>
          </div>
        </td>
        <td class="px-5 py-3"><a href="{{website}}" target="_blank" class="text-brand-600 hover:underline">{{website}}</a></td>
        <td class="px-5 py-3 text-ink-700">#{{owner_id}}</td>
        <td class="px-5 py-3 text-right">
          <form action="/admin/companies/{{id}}?_method=DELETE" method="POST" class="inline">
            <button class="px-3 py-1.5 rounded-full text-rose-600 text-xs font-semibold hover:bg-rose-50">Delete</button>
          </form>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
