<div class="d-flex justify-content-between align-items-center mb-4">
  <h4>All Users</h4>
  <a href="/admin/panel" class="btn btn-outline-secondary btn-sm">Back</a>
</div>

<table class="table table-bordered">
  <thead>
    <tr>
      <th>ID</th>
      <th>Full Name</th>
      <th>Email</th>
      <th>Role</th>
      <th>Active</th>
      <th>Action</th>
    </tr>
  </thead>
  <tbody>
    {{#each users}}
    <tr>
      <td>{{id}}</td>
      <td>{{full_name}}</td>
      <td>{{email}}</td>
      <td>{{role}}</td>
      <td>{{is_active}}</td>
      <td>
        <form action="/admin/users/{{id}}?_method=DELETE" method="POST">
          <button type="submit" class="btn btn-sm btn-danger">Delete</button>
        </form>
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>