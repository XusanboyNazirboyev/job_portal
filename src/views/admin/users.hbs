<div class="flex items-center justify-between mb-5">
  <div>
    <h1 class="text-2xl font-bold text-ink-900">All users</h1>
    <p class="text-sm text-ink-500">Search, review, and remove accounts.</p>
  </div>
  <a href="/admin/panel" class="px-4 py-2 rounded-full border border-slate-300 text-ink-700 text-sm font-semibold hover:bg-slate-50">← Back</a>
</div>

<div class="bg-white rounded-2xl shadow-card overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-slate-50 text-left text-xs uppercase tracking-wider text-ink-500">
      <tr>
        <th class="px-5 py-3">ID</th>
        <th class="px-5 py-3">User</th>
        <th class="px-5 py-3">Email</th>
        <th class="px-5 py-3">Role</th>
        <th class="px-5 py-3">Status</th>
        <th class="px-5 py-3 text-right">Action</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      {{#each users}}
      <tr class="hover:bg-slate-50">
        <td class="px-5 py-3 text-ink-500">{{id}}</td>
        <td class="px-5 py-3">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-brand-500 to-brand-700 text-white grid place-items-center text-xs font-bold">{{#if full_name}}{{full_name.[0]}}{{else}}U{{/if}}</div>
            <span class="font-medium text-ink-900">{{full_name}}</span>
          </div>
        </td>
        <td class="px-5 py-3 text-ink-700">{{email}}</td>
        <td class="px-5 py-3"><span class="chip bg-brand-50 text-brand-600">{{role}}</span></td>
        <td class="px-5 py-3">
          {{#if is_active}}<span class="chip bg-emerald-50 text-emerald-700">● Active</span>
          {{else}}<span class="chip bg-slate-100 text-ink-500">○ Inactive</span>{{/if}}
        </td>
        <td class="px-5 py-3 text-right">
          <form action="/admin/users/{{id}}?_method=DELETE" method="POST" class="inline">
            <button class="px-3 py-1.5 rounded-full text-rose-600 text-xs font-semibold hover:bg-rose-50">Delete</button>
          </form>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
