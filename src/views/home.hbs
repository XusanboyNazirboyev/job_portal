<section class='relative overflow-hidden bg-gradient-to-br from-slate-950 via-slate-900 to-blue-950 min-h-screen w-full'>

  <!-- Orqa fondagi blur effektlar -->
  <div class='absolute inset-0 pointer-events-none'>
    <div class='absolute top-20 left-20 w-72 h-72 bg-blue-500/20 rounded-full blur-3xl'></div>
    <div class='absolute bottom-20 right-20 w-96 h-96 bg-violet-500/20 rounded-full blur-3xl'></div>
  </div>

  <!-- Kontent qismi (Ekran kengayganda ham o'rtada va chiroyli turadi) -->
  <div class='relative max-w-7xl mx-auto px-6 py-20 md:py-32'>
    <div class='grid lg:grid-cols-2 gap-16 items-center'>

      <!-- Chap ustun -->
      <div>
        <span class='inline-flex items-center px-4 py-2 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-sm font-medium'>
          Trusted by thousands of job seekers
        </span>

        <h1 class='mt-8 text-5xl md:text-6xl lg:text-7xl font-bold text-white leading-tight'>
          Find Your
          <span class='text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-violet-400'>
            Dream Job
          </span>
          Today
        </h1>

        <p class='mt-6 text-xl text-slate-300 max-w-xl'>
          Explore thousands of vacancies from top companies and take the next step in your career.
        </p>

        <div class='mt-10 flex flex-wrap gap-4'>
          <a href='/auth/register' class='px-8 py-4 bg-blue-600 hover:bg-blue-700 text-white rounded-2xl font-semibold transition'>
            Get Started
          </a>
          <a href='/vacancies' class='px-8 py-4 border border-slate-700 hover:border-slate-500 text-white rounded-2xl font-semibold transition'>
            Browse Jobs
          </a>
        </div>

        <div class='mt-14 grid grid-cols-3 gap-8'>
          <div>
            <h3 class='text-3xl font-bold text-white'>20K+</h3>
            <p class='text-slate-400'>Jobs</p>
          </div>
          <div>
            <h3 class='text-3xl font-bold text-white'>5K+</h3>
            <p class='text-slate-400'>Companies</p>
          </div>
          <div>
            <h3 class='text-3xl font-bold text-white'>50K+</h3>
            <p class='text-slate-400'>Candidates</p>
          </div>
        </div>
      </div>

      <!-- O'ng ustun (Qidiruv paneli) -->
      <div>
        <div class='bg-white rounded-3xl shadow-2xl p-8'>
          <h3 class='text-2xl font-bold text-slate-900 mb-6'>Search Jobs</h3>
          
          <form action='/vacancies' method='GET'>
            <div class='space-y-4'>
              <input type='text' name='search' placeholder='Job title or keyword' class='w-full px-5 py-4 border border-slate-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-blue-500'/>
              
              <select name='category' class='w-full px-5 py-4 border border-slate-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-blue-500'>
                <option value=''>All Categories</option>
                <option>Backend</option>
                <option>Frontend</option>
                <option>Mobile</option>
                <option>DevOps</option>
                <option>UI/UX</option>
              </select>

              <button type='submit' class='w-full bg-blue-600 hover:bg-blue-700 text-white py-4 rounded-2xl font-semibold transition'>
                Search Jobs
              </button>
            </div>
          </form>

          <div class='mt-8 border-t pt-6'>
            <p class='text-sm text-slate-500 mb-4'>Popular Searches</p>
            <div class='flex flex-wrap gap-2'>
              <span class='px-3 py-2 bg-slate-100 rounded-xl text-sm'>Backend</span>
              <span class='px-3 py-2 bg-slate-100 rounded-xl text-sm'>React</span>
              <span class='px-3 py-2 bg-slate-100 rounded-xl text-sm'>Node.js</span>
              <span class='px-3 py-2 bg-slate-100 rounded-xl text-sm'>DevOps</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>