<div class="max-w-md mx-auto mt-10 bg-white rounded-2xl shadow-card p-8">
  <h1 class="text-2xl font-bold text-ink-900">Reset your password</h1>
  <p class="text-sm text-ink-500 mt-1">We'll email you a secure link to set a new one.</p>

  {{#if error}}<div class="mt-5 px-4 py-2 rounded-lg bg-rose-50 text-rose-700 text-sm">{{error}}</div>{{/if}}
  {{#if success}}<div class="mt-5 px-4 py-2 rounded-lg bg-emerald-50 text-emerald-700 text-sm">{{success}}</div>{{/if}}

  <form action="/auth/forgot-password" method="POST" class="mt-6 space-y-4">
    <label class="block">
      <span class="text-sm font-medium text-ink-700">Email</span>
      <input type="email" name="email" required class="mt-1 w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none"/>
    </label>
    <button type="submit" class="w-full py-3 rounded-full bg-brand-500 hover:bg-brand-600 text-white font-semibold">Send reset link</button>
    <a href="/auth/login" class="block text-center text-sm font-semibold text-brand-600 hover:underline">Back to sign in</a>
  </form>
</div>
