<div class="w-full min-h-screen grid md:grid-cols-2 bg-white overflow-hidden">
  <!-- Chap tomondagi Forma -->
  <div class="p-8 md:p-16 flex flex-col justify-center order-2 md:order-1 bg-white">
    <div class="max-w-md w-full mx-auto">
      <h1 class="text-3xl font-bold text-[#0b1a2b]">Create your account</h1>
      <p class="text-sm text-slate-500 mt-1">Make the most of your professional life.</p>

      {{#if error}}<div class="mt-5 px-4 py-2 rounded-lg bg-rose-50 text-rose-700 text-sm">{{error}}</div>{{/if}}

      <form action="/auth/register" method="POST" class="mt-8 space-y-4">
        <label class="block">
          <span class="text-sm font-medium text-slate-700">Full name</span>
          <input type="text" name="full_name" required class="mt-1 w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-[#0a66c2] focus:ring-2 focus:ring-[#0a66c2]/20 outline-none"/>
        </label>
        <label class="block">
          <span class="text-sm font-medium text-slate-700">Email</span>
          <input type="email" name="email" required class="mt-1 w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-[#0a66c2] focus:ring-2 focus:ring-[#0a66c2]/20 outline-none"/>
        </label>
        <label class="block">
          <span class="text-sm font-medium text-slate-700">Password <span class="text-slate-400">(6+ characters)</span></span>
          <input type="password" name="password" minlength="6" required class="mt-1 w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-[#0a66c2] focus:ring-2 focus:ring-[#0a66c2]/20 outline-none"/>
        </label>
        <div>
          <span class="text-sm font-medium text-slate-700">I want to</span>
          <div class="mt-2 grid grid-cols-2 gap-2">
            <label class="cursor-pointer">
              <input type="radio" name="role" value="candidate" class="peer sr-only" checked />
              <div class="px-4 py-3 rounded-xl border border-slate-300 peer-checked:border-[#0a66c2] peer-checked:bg-[#eaf3fb] text-center">
                <div class="font-semibold text-[#0b1a2b]">Find a job</div>
                <div class="text-xs text-slate-500">As a candidate</div>
              </div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="role" value="company" class="peer sr-only"/>
              <div class="px-4 py-3 rounded-xl border border-slate-300 peer-checked:border-[#0a66c2] peer-checked:bg-[#eaf3fb] text-center">
                <div class="font-semibold text-[#0b1a2b]">Hire talent</div>
                <div class="text-xs text-slate-500">As a company</div>
              </div>
            </label>
          </div>
        </div>
        <button type="submit" class="w-full py-3 mt-2 rounded-full bg-[#0a66c2] hover:bg-[#0958a8] text-white font-semibold transition-colors">Agree & Join</button>
      </form>

      <p class="mt-8 text-sm text-center text-slate-600">Already on JobHive?
        <a href="/auth/login" class="font-semibold text-[#0a66c2] hover:underline">Sign in</a>
      </p>
    </div>
  </div>

  <!-- O'ng tomondagi Ko'k Banner -->
  <div class="hidden md:flex flex-col justify-between p-16 bg-gradient-to-br from-[#0a66c2] to-[#07457f] text-white order-1 md:order-2 min-h-screen">
    <a href="/" class="flex items-center gap-2 font-extrabold text-2xl">
      <span class="w-10 h-10 rounded-lg bg-white text-[#0a66c2] grid place-items-center text-xl">J</span>
      JobHive
    </a>
    <div class="max-w-md">
      <h2 class="text-4xl font-bold leading-tight">Join 1M+ professionals.</h2>
      <ul class="mt-6 space-y-3 text-white/90 text-base">
        <li>✓ Apply with one click</li>
        <li>✓ Get matched to the right roles</li>
        <li>✓ Track every application</li>
      </ul>
    </div>
    <p class="text-xs text-white/70">By joining you agree to our Terms & Privacy.</p>
  </div>
</div>