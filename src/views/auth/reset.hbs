<div class="max-w-md mx-auto mt-10 bg-white rounded-2xl shadow-card p-8">
  <h1 class="text-2xl font-bold text-ink-900">Choose a new password</h1>
  <p class="text-sm text-ink-500 mt-1">Use at least 6 characters with a mix of letters and numbers.</p>

  {{#if error}}<div class="mt-5 px-4 py-2 rounded-lg bg-rose-50 text-rose-700 text-sm">{{error}}</div>{{/if}}

  <form action="/auth/reset-password" method="POST" class="mt-6 space-y-4">
    <input type="hidden" name="token" value="{{token}}"/>
    <label class="block">
      <span class="text-sm font-medium text-ink-700">New password</span>
      <input type="password" name="password" minlength="6" required class="mt-1 w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none"/>
    </label>
    <button type="submit" class="w-full py-3 rounded-full bg-brand-500 hover:bg-brand-600 text-white font-semibold">Update password</button>
  </form>
</div>
