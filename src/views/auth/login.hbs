<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Sign in — JobHive</title>
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>body{font-family:'Inter',sans-serif}</style>
</head>
<body class="min-h-screen bg-white">
  <div class="w-full min-h-screen grid md:grid-cols-2 bg-white overflow-hidden">
    
    <div class="hidden md:flex flex-col justify-between p-16 bg-gradient-to-br from-[#0a66c2] to-[#07457f] text-white min-h-screen">
      <a href="/" class="flex items-center gap-2 font-extrabold text-2xl">
        <span class="w-10 h-10 rounded-lg bg-white text-[#0a66c2] grid place-items-center text-xl">J</span>
        JobHive
      </a>
      <div class="max-w-md">
        <h2 class="text-4xl font-bold leading-tight">Welcome back to your career hub.</h2>
        <p class="mt-4 text-white/80 text-base">Discover roles, track applications, and chat with hiring teams — all in one place.</p>
      </div>
      <p class="text-xs text-white/70">© JobHive — Where talent meets opportunity.</p>
    </div>

    <div class="p-8 md:p-16 flex flex-col justify-center bg-white min-h-screen">
      <div class="max-w-md w-full mx-auto">
        <h1 class="text-3xl font-bold text-[#0b1a2b]">Sign in</h1>
        <p class="text-sm text-slate-500 mt-1">Stay updated on your professional world.</p>

        {{#if error}}<div class="mt-5 px-4 py-2 rounded-lg bg-rose-50 text-rose-700 text-sm">{{error}}</div>{{/if}}
        {{#if success}}<div class="mt-5 px-4 py-2 rounded-lg bg-emerald-50 text-emerald-700 text-sm">{{success}}</div>{{/if}}

        <form action="/auth/login" method="POST" class="mt-8 space-y-4">
          <label class="block">
            <span class="text-sm font-medium text-slate-700">Email</span>
            <input type="email" name="email" required class="mt-1 w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-[#0a66c2] focus:ring-2 focus:ring-[#0a66c2]/20 outline-none"/>
          </label>
          <label class="block">
            <span class="text-sm font-medium text-slate-700">Password</span>
            <input type="password" name="password" required class="mt-1 w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-[#0a66c2] focus:ring-2 focus:ring-[#0a66c2]/20 outline-none"/>
          </label>
          <div class="flex justify-end">
            <a href="/auth/forgot-password" class="text-sm font-semibold text-[#0a66c2] hover:underline">Forgot password?</a>
          </div>
          <button type="submit" class="w-full py-3 mt-2 rounded-full bg-[#0a66c2] hover:bg-[#0958a8] text-white font-semibold transition">Sign in</button>
        </form>

        <p class="mt-8 text-sm text-center text-slate-600">New to JobHive?
          <a href="/auth/register" class="font-semibold text-[#0a66c2] hover:underline">Join now</a>
        </p>
      </div>
    </div>

  </div>
</body>
</html>