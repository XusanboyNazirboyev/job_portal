<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Job Portal</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>

  {{#if showNavbar}}
    {{#if isAdmin}}
    <nav class="navbar navbar-dark bg-danger px-4">
      <a class="navbar-brand" href="/admin/panel">Admin Panel</a>
      <div>
        <a href="/admin/users" class="text-white me-3">Users</a>
        <a href="/admin/companies" class="text-white me-3">Companies</a>
        <a href="/admin/categories" class="text-white me-3">Categories</a>
        <a href="/auth/logout" class="btn btn-outline-light btn-sm">Logout</a>
      </div>
    </nav>
    {{else}}
    <nav class="navbar navbar-dark bg-dark px-4">
      <a class="navbar-brand" href="/">Job Portal</a>
      <div>
        <a href="/vacancies" class="text-white me-3">Vacancies</a>
        {{#if isCandidate}}
          <a href="/applications/my" class="text-white me-3">My Applications</a>
        {{/if}}
        {{#if isCompany}}
          <a href="/companies/panel" class="text-white me-3">Panel</a>
        {{/if}}
        <a href="/auth/logout" class="btn btn-outline-light btn-sm">Logout</a>
      </div>
    </nav>
    {{/if}}
  {{/if}}

  <div class="container mt-4">
    {{{body}}}
  </div>

</body>
</html>