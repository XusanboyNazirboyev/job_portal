<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>JobHive — Find your next role</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
          colors: {
            brand: { 50:'#eaf3fb',100:'#d4e7f7',500:'#0a66c2',600:'#0958a8',700:'#07457f' },
            ink: { 900:'#0b1a2b', 700:'#36495e', 500:'#5e6d7e' },
            surface: { 50:'#f4f2ee', 100:'#eef3f8' }
          },
          boxShadow: { card: '0 1px 2px rgba(0,0,0,.06), 0 4px 12px rgba(8,30,56,.04)' }
        }
      }
    }
  </script>
  <style>
    body{font-family:'Inter',sans-serif;background:#f4f2ee;color:#0b1a2b}
    .chip{display:inline-flex;align-items:center;gap:.35rem;padding:.25rem .6rem;border-radius:9999px;font-size:.75rem;font-weight:500}
  </style>
</head>
<body class="min-h-screen antialiased">

  {{#if showNavbar}}
    {{#if isAdmin}}
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-6 h-14 flex items-center justify-between">
        <a href="/admin/panel" class="flex items-center gap-2 font-bold text-ink-900">
          <span class="w-8 h-8 rounded-lg bg-rose-600 text-white grid place-items-center">A</span>
          Admin Console
        </a>
        <nav class="flex items-center gap-1 text-sm">
          <a href="/admin/users" class="px-3 py-2 rounded-lg text-ink-700 hover:bg-slate-100">Users</a>
          <a href="/admin/companies" class="px-3 py-2 rounded-lg text-ink-700 hover:bg-slate-100">Companies</a>
          <a href="/admin/categories" class="px-3 py-2 rounded-lg text-ink-700 hover:bg-slate-100">Categories</a>
          <a href="/auth/logout" class="ml-2 px-4 py-1.5 rounded-full border border-rose-600 text-rose-600 hover:bg-rose-50 font-semibold">Logout</a>
        </nav>
      </div>
    </header>
    {{else}}
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-6 h-14 flex items-center gap-6">
        <a href="/" class="flex items-center gap-2 font-extrabold text-ink-900 text-lg">
          <span class="w-8 h-8 rounded-lg bg-brand-500 text-white grid place-items-center">J</span>
          JobHive
        </a>
        <div class="hidden md:flex flex-1 max-w-md relative">
          <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          <input placeholder="Search jobs, titles, companies" class="w-full pl-9 pr-3 py-2 rounded-lg bg-surface-100 text-sm focus:bg-white focus:ring-2 focus:ring-brand-500 outline-none" />
        </div>
        <nav class="ml-auto flex items-center gap-1 text-sm">
          <a href="/vacancies" class="flex flex-col items-center px-3 py-1 text-ink-500 hover:text-ink-900">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 7h-4V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2Z"/></svg>
            <span class="text-xs mt-0.5">Jobs</span>
          </a>
          {{#if isCandidate}}
          <a href="/applications/my" class="flex flex-col items-center px-3 py-1 text-ink-500 hover:text-ink-900">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
            <span class="text-xs mt-0.5">Applications</span>
          </a>
          {{/if}}
          {{#if isCompany}}
          <a href="/companies/panel" class="flex flex-col items-center px-3 py-1 text-ink-500 hover:text-ink-900">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 9h1m4 0h1M9 13h1m4 0h1M9 17h1m4 0h1"/></svg>
            <span class="text-xs mt-0.5">Company</span>
          </a>
          {{/if}}
          <a href="/users/me" class="flex flex-col items-center px-3 py-1 text-ink-500 hover:text-ink-900">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
            <span class="text-xs mt-0.5">Me</span>
          </a>
          <a href="/auth/logout" class="ml-3 text-ink-500 hover:text-ink-900 text-sm">Sign out</a>
        </nav>
      </div>
    </header>
    {{/if}}
  {{/if}}

  <main class="w-full">
    {{{body}}}
  </main>

</body>
</html>
